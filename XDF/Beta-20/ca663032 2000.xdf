  <XDFPATCH uniqueid="0x6843">
    <title>KWP IOCLID Privilege Escalation</title>
    <description>Adds a new InputOutputControlByLocalIdentifier, 0xBB, that upon passing to LONG_TERM_ADJUSTMENT, escalates privileges in current diagnostic session to Siemens level</description>
    <CATEGORYMEM index="0" category="105" />
    <XDFPATCHENTRY name="Extend identifier list" address="0x63E06" datasize="0x4" patchdata="DA0FE05D" basedata="E7FC3100" />
    <XDFPATCHENTRY name="Escalate privileges" address="0x75DE0" datasize="0x16" patchdata="47F8BB00EA20EE5DE7FC3100DB00E178F7F84BF4DB00" basedata="FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF" />
  </XDFPATCH>
