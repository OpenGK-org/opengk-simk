  <ADXMACRO id="FASTINIT" idhash="0x338906C2" title="FastInit" repeatcount="1">
    <desc>Wake up Sequence&#013;&#010;-------------------------------&#013;&#010;1. Set baudrate to 360&#013;&#010; (9 bits at 360 baud = 25ms)&#013;&#010;2. Send 0x00 to pulse the K-Line.&#013;&#010;3. Then wait 25ms &#013;&#010;4. Change the baud to 10,400&#013;&#010;5. FastInit complete</desc>
    <NODE commandID="FASTINIT_HIGH" repeatcount="1" />
    <NODE commandID="25MSPAUSE" repeatcount="1" />
    <NODE commandID="FASTINIT_LOW" repeatcount="1" />
    <NODE commandID="25MSPAUSE" repeatcount="1" />
  </ADXMACRO>

