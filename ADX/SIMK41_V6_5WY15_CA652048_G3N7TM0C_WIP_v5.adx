    <bytestring size="0x4">8111F120</bytestring>
  </ADXCSENDCOMMAND>

  <ADXCSENDCOMMAND id="FASTINIT_LOW" idhash="0x632740F0" title="FastInit_Low">
    <desc>Setting baud rate to 360&#013;&#010;(9 bits at 360 baud = 25ms)</desc>
    <baud>360</baud>
    <bytestring size="0x1">00</bytestring>
  </ADXCSENDCOMMAND>

  <ADXCSENDCOMMAND id="FASTINIT_HIGH" idhash="0x6F67340C" title="FastInit_High">
