    <parentcmdidhash>0xDAA83ACD</parentcmdidhash>
    <units>Intake air temp sensor voltage (V)</units>
    <packetoffset>0x05</packetoffset>
    <range low="0.000000" high="5.000000" />
    <alarms low="0.000000" high="255.000000" />
    <digcount>2</digcount>
    <outputtype>3</outputtype>
    <datatype>1</datatype>
    <unittype>32</unittype>
    <MATH equation="X * 5 / 255">
      <VAR varID="X" type="native" />
    </MATH>
  </ADXVALUE>

  <ADXVALUE id="INTAKETEMPERAT" idhash="0x882F9623" title="Intake Air Temp">
    <desc>Same as KSW_dmg210 adx. &#013;&#010;Increased when I heated area around intake temp sensor, also increased while sitting still with hot engine,then decreased when throttle applied. didnt move when momentairly disconnecting sensor, so must have some error handling/smoothing.&#013;&#010;&#013;&#010;according to Claude the ram address is 0xC5B6</desc>
    <parentcmdidhash>0xDAA83ACD</parentcmdidhash>
