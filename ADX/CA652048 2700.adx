  <ADXVALUE id="AVERAGETOTALFU" idhash="0x4D4D4AC2" title="Average Total Fuel Trim*">
    <desc>average of total fuel trim from banks 1 and 2</desc>
    <units>Average Total Fuel Trim* (%)</units>
    <packetoffset>0x00</packetoffset>
    <range low="-100.000000" high="100.000000" />
    <alarms low="0.000000" high="255.000000" />
    <digcount>1</digcount>
    <outputtype>3</outputtype>
    <datatype>46</datatype>
    <unittype>67</unittype>
    <MATH equation="(x+y)/2">
      <VAR varID="x" type="link" linkIDHash="0x44ACE3A1" />
      <VAR varID="y" type="link" linkIDHash="0x47F8E3A1" />
    </MATH>
  </ADXVALUE>

  <ADXVALUE id="TOTALFUELTRIM" idhash="0x4083103A" title="Average fuel trim multiplier">
    <desc>Average total fuel trim (excluding idle fuel trim) /100 +1</desc>
    <units>Average fuel trim multiplier</units>
    <packetoffset>0x00</packetoffset>
    <range low="0.500000" high="1.500000" />
    <alarms low="0.000000" high="255.000000" />
    <digcount>2</digcount>
    <outputtype>3</outputtype>
    <datatype>46</datatype>
    <unittype>67</unittype>
    <MATH equation="(s1+s2+(l1+l2)*(1-I))/200+1">
      <VAR varID="s1" type="link" linkIDHash="0xF60C0FDD" />
      <VAR varID="s2" type="link" linkIDHash="0xF60C157D" />
      <VAR varID="l1" type="link" linkIDHash="0x30FDD0DC" />
      <VAR varID="l2" type="link" linkIDHash="0x30FDCA7C" />
      <VAR varID="I" type="link" linkIDHash="0x68EF6C6" />
    </MATH>
  </ADXVALUE>

  <ADXVALUE id="O2DUTYB1UP" idhash="0xBD6F75DF" title="Bank 1 Upstream O2 Heater Duty ">
    <desc>closely matched with 0x47. 0 at rest ~63 after engine start, climbs to ~250, settles after a while, matches what I would expect from o2 sensor heaters, assumed it was upstream bank1/bank2 because was active even when downstream sensors disabled.&#013;&#010;&#013;&#010;according to claude the ram address is 0xE2CE</desc>
