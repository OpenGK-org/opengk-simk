    <units>Upstream O2 voltage bank 2 (V)</units>
    <packetoffset>0x1E</packetoffset>
    <range low="0.000000" high="5.000000" />
    <alarms low="0.000000" high="255.000000" />
    <digcount>2</digcount>
    <outputtype>3</outputtype>
    <datatype>58</datatype>
    <unittype>32</unittype>
    <MATH equation="0.0195887 * X">
      <VAR varID="X" type="native" />
    </MATH>
  </ADXVALUE>

  <ADXVALUE id="O2VOLTSB1DOWN" idhash="0xFB3D8B5A" title="Downstream O2 voltage bank 1">
    <desc>My downstream O2 sensors were too short to fit in my headers, They read high (~250) when loose in engine bay, went to 0 when I disabled C_CONF_CAT_EFF and disconnected the sensors.&#013;&#010;&#013;&#010;according to Claude the ram address is 0xE24E</desc>
    <parentcmdidhash>0xDAA83ACD</parentcmdidhash>
    <units>Downstream O2 voltage bank 1 (V)</units>
    <packetoffset>0x1F</packetoffset>
    <range low="0.000000" high="5.000000" />
    <alarms low="0.000000" high="255.000000" />
    <digcount>2</digcount>
    <outputtype>3</outputtype>
    <datatype>58</datatype>
    <unittype>32</unittype>
    <MATH equation="0.0195887 * X">
      <VAR varID="X" type="native" />
    </MATH>
  </ADXVALUE>

