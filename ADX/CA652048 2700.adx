    <packetoffset>0x49</packetoffset>
    <range low="64.000000" high="192.000000" />
    <alarms low="0.000000" high="255.000000" />
    <digcount>2</digcount>
    <outputtype>3</outputtype>
    <datatype>3</datatype>
    <unittype>3</unittype>
    <MATH equation="X">
      <VAR varID="X" type="native" />
    </MATH>
  </ADXVALUE>

  <ADXVALUE id="O2DUTYB1DOWN" idhash="0xB79F6215" title="Downstream O2 sensor heater duty Bank 1 ">
    <desc>closely matched with 0x4B. 0 if engine stopped or C_CONF_CAT_EFF disabled. from logs before disabling C_CONF_CAT_EFF it was ~63 at start then jumps to ~250 after a while, settles at ~188 max, my guess is downstream o2 sensor duty because with C_CONF_CAT_EFF enabled the behavour was similar to bank 1 upstream duty.&#013;&#010;&#013;&#010;according to claude the ram address is 0xE2DC&#013;&#010;</desc>
    <parentcmdidhash>0xDAA83ACD</parentcmdidhash>
    <units>Downstream O2 sensor heater duty Bank 1 (%)</units>
    <packetoffset>0x4A</packetoffset>
    <range low="0.000000" high="100.000000" />
