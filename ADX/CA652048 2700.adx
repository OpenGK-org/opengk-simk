  <ADXVALUE id="BANK1TOTALFUEL" idhash="0x44ACE3A1" title="Bank 1 total fuel trim*">
    <desc>equation for total fuel trim (stft+ltft accounting for idle/part load)</desc>
    <units>Bank 1 total fuel trim* (%)</units>
    <packetoffset>0x00</packetoffset>
    <range low="-100.000000" high="100.000000" />
    <alarms low="0.000000" high="255.000000" />
